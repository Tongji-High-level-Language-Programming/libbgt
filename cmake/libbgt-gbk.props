<?xml version="1.0" encoding="utf-8"?>
<!--
  libbgt GBK 构建的属性表（Visual Studio）。

  用法：属性管理器（View > Other Windows > Property Manager）中右键工程，
  选择“添加现有属性表”，选中本文件即可。

  作用：让本工程的所有 .cpp 按 GBK（代码页 936）读取、并让窄字符串在运行期
  保持 GBK。libbgt 内部会在交给 SDL 之前把字符串转换成 UTF-8，因此学生的
  源码、printf 输出、存档文件都统一是 GBK。

  注意：本属性表不能与 /utf-8 同时使用（MSVC 会报 D8016）。若工程里另有
  /utf-8，请一并去掉。

  完整说明（两种编码模式的对照、SDL 边界转换点、已知限制等）见仓库里的
  docs/encoding.md。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/source-charset:.936 /execution-charset:.936 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>BGT_SOURCE_ENCODING=BGT_ENCODING_GBK;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
